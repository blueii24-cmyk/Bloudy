# ── bloud environment ────────────────────────────────────────────────────────
# Copy to .env.local for local dev, or set these in Vercel → Project → Settings.

# 1) Dropbox app (required)
#    https://www.dropbox.com/developers/apps → Create app
#      • Choose "Scoped access"
#      • Choose "Full Dropbox"
#      • Permissions: files.metadata.read, files.content.read, files.content.write
#      • OAuth 2 → Redirect URIs: https://<your-app>.vercel.app/api/auth/callback
#    Only the App key is needed — the flow uses PKCE, so no secret is stored.
DROPBOX_APP_KEY=

# Optional: set only if you want a confidential-client flow / stable cookie key.
# DROPBOX_APP_SECRET=
# BLOUD_SECRET=

# 2) Credential vault (required — holds your Dropbox refresh token)
#    Supabase → Project → Settings → API. Use the service_role key; it is
#    only ever read server-side.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# 3) Library location inside Dropbox
BLOUD_FOLDER=/bloud

# 4) Privacy gate: the Vercel URL is public. Set a passcode to require unlocking.
# BLOUD_PASSCODE=

# 5) Optional: mirror audio into Vercel Blob for faster repeat plays
#    (needs BLOB_READ_WRITE_TOKEN). Artwork is always mirrored when available.
# BLOB_READ_WRITE_TOKEN=
# BLOUD_CACHE_MEDIA=0

# 6) Optional: pin the redirect URI if your deployment URL differs
# DROPBOX_REDIRECT_URI=https://bloud.example.com/api/auth/callback
